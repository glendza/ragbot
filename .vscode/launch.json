{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ragbot",
      "type": "debugpy",
      "request": "launch",
      "module": "ragbot",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
    },
    {
      "name": "Import data to Milvus",
      "type": "debugpy",
      "request": "launch",
      "module": "ragbot.cli.__init__",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "milvus",
        "import-data",
      ],
    },
    {
      "name": "Search Milvus",
      "type": "debugpy",
      "request": "launch",
      "module": "ragbot.cli.__init__",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "args": [
        "milvus",
        "search",
        "${input:enterSearchQuery}",
      ],
    },
    {
      "name": "Debug Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "inputs": [
    {
      "id": "enterSearchQuery",
      "type": "promptString",
      "description": "Enter search query",
    },
  ],
}